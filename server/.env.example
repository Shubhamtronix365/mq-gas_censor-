# ==============================================================================
# SenseGrid Backend (FastAPI) Environment Configuration Template
# ==============================================================================
# Rename this file to '.env' and adjust the variables to match your system.
# Do NOT commit the actual '.env' file containing secrets to version control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL format: postgresql://[user]:[password]@[host]:[port]/[database]
# If left blank, the application will automatically fallback to a local SQLite 'sensegrid.db' file.
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/sensegrid

# ------------------------------------------------------------------------------
# 2. JWT SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Generate a secure 32-byte key: 'openssl rand -hex 32'
SECRET_KEY=your_generated_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. PAYU PAYMENT GATEWAY SETTINGS
# ------------------------------------------------------------------------------
# Environment Type: 'test' / 'sandbox' or 'production'
PAYU_ENV=test
PAYU_KEY=gtKFFx
PAYU_SALT=eCwWELSp

# ------------------------------------------------------------------------------
# 4. DEPLOYMENT & NETWORK IDENTIFIERS
# ------------------------------------------------------------------------------
# Base URLs used for redirects and CORS access checks
# Local Dev Example:
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173
# Production Example:
BACKEND_URL=https://mq-gas-censor-sensegrid-api-tronix.onrender.com
FRONTEND_URL=https://mq-gas-censor-tronix.pages.dev

# Comma-separated list of CORS origins allowed to access the backend API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5173/,https://indianiiot.com,https://indianiiot.com/,https://mq-gas-censor-tronix.pages.dev,https://mq-gas-censor-tronix.pages.dev/
