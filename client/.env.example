# ==============================================================================
# SenseGrid Frontend (React + Vite) Environment Configuration Template
# ==============================================================================
# Rename this file to '.env' in the client root directory.
# In Vite, variables must be prefixed with 'VITE_' to be exposed to the client bundle.

# Base URL of the running FastAPI Backend server
VITE_API_URL=http://localhost:8000

# Google OAuth Client ID
# Obtain this from your Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Make sure to authorize 'http://localhost:5173' and 'https://mq-gas-censor-tronix.pages.dev' as Javascript Origins.
VITE_GOOGLE_CLIENT_ID=your_real_google_client_id_here.apps.googleusercontent.com
